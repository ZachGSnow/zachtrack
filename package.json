    "@tsconfig/svelte": "^5.0.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.2",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
