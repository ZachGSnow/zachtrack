# Copy to wrangler.toml (git-ignored) and fill in your own values.
# See README.md "Deploy your own" for where each value comes from.
name = "zachtrack"
pages_build_output_dir = "dist"
compatibility_date = "2026-10-01"

[[d1_databases]]
binding = "DB"
database_name = "zachtrack-db"
database_id = "00000000-0000-0000-0000-000000000000"
# Schema changes after v1.5.0 (applied by `npm run deploy`, see d1/migrations/README.md).
migrations_dir = "d1/migrations"

[vars]
# The only email the sync endpoint accepts. Must match your Access policy.
OWNER_EMAIL = "you@example.com"
# Your Zero Trust team domain (Zero Trust > Settings > Custom Pages).
ACCESS_TEAM_DOMAIN = "your-team.cloudflareaccess.com"
# The Access application's AUD tag (Zero Trust > Access > Applications >
# your app > Overview). Required: without it the endpoints refuse every request.
ACCESS_AUD = "<your-access-aud-tag>"
# Optional: daily reminders on your phone (README "Reminders"). The public key
# from `npm run vapid-keys`, the same one the backup Worker has; the private
# key is a secret: `npx wrangler pages secret put VAPID_PRIVATE_KEY`.
# VAPID_PUBLIC_KEY = ""
# VAPID_SUBJECT = "https://zachtrack.example.com"

# Optional: the nightly backup bucket (README "Backups"), so Today can say when the
# last server backup ran (/api/backup-status). Leave it out if you don't run the backup Worker.
# [[r2_buckets]]
# binding = "BACKUPS"
# bucket_name = "zachtrack-backups"
