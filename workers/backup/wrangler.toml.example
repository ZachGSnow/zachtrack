# Copy to wrangler.toml in this folder (git-ignored) and fill in your values.
# See README.md "Backups" for setup.
name = "zachtrack-backup"
main = "index.ts"
compatibility_date = "2026-10-01"

# No public URL: this Worker only runs on its schedule.
workers_dev = false
preview_urls = false

[triggers]
# Every 15 minutes: the backup at 09:00 UTC, daily reminders on the other
# runs (ARCHITECTURE.md 3.73). One cron trigger either way.
crons = ["*/15 * * * *"]

# Reminders. The public key from `npm run vapid-keys`; the private key is a
# secret: `npx wrangler secret put VAPID_PRIVATE_KEY` in this folder. A push
# service may use the subject to reach whoever runs the server.
[vars]
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = "https://zachtrack.example.com"

[[d1_databases]]
binding = "DB"
database_name = "zachtrack-db"
database_id = "00000000-0000-0000-0000-000000000000"

[[r2_buckets]]
binding = "BACKUPS"
bucket_name = "zachtrack-backups"
